# Salin file ini menjadi .env lalu isi dari Supabase:
# Project Settings > API > Project URL dan anon public key.
# JANGAN isi service_role key di sini — itu rahasia dan tidak dipakai frontend.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Email akun admin yang dibuat di Supabase > Authentication > Users.
# Kalau ini diisi, halaman login admin hanya meminta password saja.
VITE_ADMIN_EMAIL=admin@contoh.com
